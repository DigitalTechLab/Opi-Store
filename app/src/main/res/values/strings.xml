    <string name="github_tutorial_title">GitHub Token Tutorial</string>
    <string name="github_tutorial_step1">1. Open this link: https://github.com/settings/tokens</string>
    <string name="github_tutorial_step2">2. Log in (or create an account).</string>
    <string name="github_tutorial_step3">3. Click on \"Generate new token\" and select \"classic\".</string>
    <string name="github_tutorial_step4">4. Give the token a name.</string>
    <string name="github_tutorial_step5">5. Select ALL scopes.</string>
    <string name="github_tutorial_step6">6. For \"Expiration\", select \"No expiration\".</string>
    <string name="github_tutorial_step7">7. Click \"Generate token\" at the bottom.</string>
    <string name="github_tutorial_step8">8. Copy the token and paste it here in the app.</string>

    <string name="codeberg_tutorial_title">Codeberg Token Tutorial</string>
    <string name="codeberg_tutorial_step1">1. Open this link: https://codeberg.org/user/settings/applications</string>
    <string name="codeberg_tutorial_step2">2. Log in (or create an account).</string>
    <string name="codeberg_tutorial_step3">3. Under \"Access Tokens\", click \"New Access Token\".</string>
    <string name="codeberg_tutorial_step4">4. Give the token a name.</string>
    <string name="codeberg_tutorial_step5">5. For \"Repository and Organization Access\", select \"All (public, private, limited)\".</string>
    <string name="codeberg_tutorial_step6">6. For all permissions, select \"Read and Write\".</string>
    <string name="codeberg_tutorial_step7">7. Click \"Generate Token\".</string>
    <string name="codeberg_tutorial_step8">8. Copy the token and paste it here in the app.</string>

